# Copia este archivo a .streamlit/secrets.toml y completa con los datos reales
# de tu proyecto de Supabase: botón "Connect" (arriba a la derecha en el dashboard)
# > Direct connection > Connection Method = "Transaction pooler" > Type = "SQLAlchemy".
#
# Usa la cadena del "Transaction pooler" (puerto 6543), no la conexión directa:
# Streamlit Community Cloud abre y cierra conexiones cortas y el pooler de Supabase
# está pensado para ese patrón de uso.
#
# Si tu contraseña tiene caracteres especiales (@ / # % etc.) debes percent-encodearlos
# o la URL queda mal formada.
#
# .streamlit/secrets.toml NUNCA debe subirse al repositorio (ya está en .gitignore).

[connections.supabase]
url = "postgresql+psycopg2://postgres.xxxxxxxxxxxx:TU_PASSWORD@aws-0-us-west-2.pooler.supabase.com:6543/postgres?sslmode=require"
pool_pre_ping = true

# Opcional: habilita respuestas redactadas por IA en la página Asistente (capa gratuita de
# Google AI Studio). Sin esto, el Asistente sigue funcionando solo con búsqueda por
# palabras clave. Crea tu API key gratis en https://aistudio.google.com/apikey
[gemini]
api_key = "TU_GEMINI_API_KEY"

# Opcional: notifica por correo a todos los usuarios activos cuando se publica un anuncio
# nuevo en la página Anuncios. Sin esto, los anuncios se siguen publicando normalmente, solo
# que sin correo. Envía vía SMTP desde una casilla real (Outlook/Office 365, Gmail, etc.) —
# no hace falta verificar ningún dominio propio.
#
# Para Outlook/Office 365 personal: outlook.com -> Configuración -> Correo -> Sincronizar
# correo -> "Contraseñas de aplicación" (requiere verificación en dos pasos activada).
# Para correo corporativo de Microsoft 365 con MFA, genera la contraseña de aplicación desde
# el portal de tu organización (o pide a IT que la habilite si está bloqueada por política).
# Usa esa contraseña de aplicación aquí, NUNCA tu contraseña normal.
[smtp]
email = "tu_correo@outlook.com"
app_password = "TU_CONTRASEÑA_DE_APLICACION"
# host = "smtp.office365.com"   # opcional, ya es el valor por defecto
# port = 587                    # opcional, ya es el valor por defecto
