# Copia este archivo a .streamlit/secrets.toml y completa con los datos reales
# de tu proyecto de Supabase: botón "Connect" (arriba a la derecha en el dashboard)
# > Direct connection > Connection Method = "Transaction pooler" > Type = "SQLAlchemy".
#
# Usa la cadena del "Transaction pooler" (puerto 6543), no la conexión directa:
# Streamlit Community Cloud abre y cierra conexiones cortas y el pooler de Supabase
# está pensado para ese patrón de uso.
#
# Si tu contraseña tiene caracteres especiales (@ / # % etc.) debes percent-encodearlos
# o la URL queda mal formada.
#
# .streamlit/secrets.toml NUNCA debe subirse al repositorio (ya está en .gitignore).

[connections.supabase]
url = "postgresql+psycopg2://postgres.xxxxxxxxxxxx:TU_PASSWORD@aws-0-us-west-2.pooler.supabase.com:6543/postgres?sslmode=require"
pool_pre_ping = true

# Opcional: habilita respuestas redactadas por IA en la página Asistente (capa gratuita de
# Google AI Studio). Sin esto, el Asistente sigue funcionando solo con búsqueda por
# palabras clave. Crea tu API key gratis en https://aistudio.google.com/apikey
[gemini]
api_key = "TU_GEMINI_API_KEY"

# Opcional: al publicar un anuncio, la app llama a esta URL para que un flujo de Power
# Automate envíe un correo. Crea en Power Automate un flujo instantáneo con el
# disparador "Cuando se recibe una solicitud HTTP", pega aquí la URL que genera, y
# agrega después del disparador la acción de enviar correo usando los campos title,
# description, priority, priority_label, recipients, module, author, author_email y
# created_at que llegan en el cuerpo (JSON) de la solicitud. "recipients" trae los
# correos de todos los usuarios activos de la app, separados por ";" — úsalo como
# destinatario del correo en vez de una dirección fija.
#
# OJO: si tu tenant crea flujos sobre el dominio *.environment.api.powerplatform.com,
# el disparador "Cuando se recibe una solicitud HTTP" puede exigir un token OAuth de
# Microsoft Entra ID además de la URL (error "DirectApiAuthorizationRequired"). Si te
# pasa, pide a tu administrador de Power Platform que revise esa política del entorno,
# o implementa la autenticación OAuth del lado de la app antes de usar esta integración.
[power_automate]
anuncios_webhook_url = "TU_URL_DEL_FLUJO_DE_POWER_AUTOMATE"

# Opcional: al publicar un anuncio, la app publica una tarjeta adaptable en un canal de
# Teams llamando a esta URL. En el canal de Teams: "..." junto al canal > Workflows >
# busca la plantilla "Enviar alertas de webhook a un canal" (reemplaza al Incoming
# Webhook clásico, que Microsoft está retirando), elige el canal destino, créala y copia
# la URL que te da. A diferencia del webhook de arriba, este SÍ funciona solo con la URL,
# sin autenticación adicional — pero espera el cuerpo en formato Adaptive Card, no JSON
# plano (la app ya arma esa tarjeta en lib/integrations.py).
[teams]
anuncios_webhook_url = "TU_URL_DEL_WEBHOOK_DE_TEAMS"
